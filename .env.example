# Firebase — mismo proyecto compartido por todas las landings de jugadores.
# Copiá estos valores desde cualquier landing individual (o desde la consola
# de Firebase → Configuración del proyecto → Tus apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dominio que se agrega al usuario de las cuentas de jugador que crea
# /jugadores/nuevo (nicolas_fernandez → nicolas_fernandez@<dominio>).
# Tiene que ser igual a PLAYER_LOGIN_DOMAIN de abajo.
VITE_PLAYER_LOGIN_DOMAIN=jugadores.ledsports.app

# OJO: este proyecto NO lleva VITE_PLAYER_SLUG.
# El slug sale del parámetro de la URL (/jugador/:slug).

# ─── SOLO SERVIDOR (funciones de Netlify) ───────────────────────
# Estas NO llevan el prefijo VITE_: así Vite nunca las mete en el
# bundle del navegador. En Netlify cargalas con scope "Functions".
# Nunca las subas al repo (el .env está en .gitignore).

# API-Football. PROVIDER: "apisports" (key de dashboard.api-football.com)
# o "rapidapi" (key de RapidAPI).
API_FOOTBALL_KEY=
API_FOOTBALL_PROVIDER=apisports

# Cuenta de servicio de Firebase (Console → Configuración del proyecto →
# Cuentas de servicio → Generar nueva clave privada). Del JSON que baja,
# copiá project_id, client_email y private_key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Alta de jugadores: crear cuentas en Firebase Authentication. Dejalo en
# false hasta actualizar las reglas de Firestore y Storage (ver README,
# "Alta de jugadores"): con las reglas actuales cualquier cuenta logueada
# puede escribir en todos los jugadores.
PLAYER_ACCOUNTS_ENABLED=false
PLAYER_LOGIN_DOMAIN=jugadores.ledsports.app

# Pausar la sincronización automática sin tocar código.
SYNC_ENABLED=true
